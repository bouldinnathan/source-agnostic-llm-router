# Copy only the settings you need into the environment of llm-router-gateway.
# Never commit real credentials.

# Comma-separated explicit runtimes. Prefix with ollama= or openai=.
LLM_ROUTER_DISCOVERY_URLS=ollama=http://192.168.1.20:11434,openai=http://192.168.1.21:8000/v1
# Give machines stable identities and use DNS/VPN names to follow changing IPs:
# LLM_ROUTER_DISCOVERY_URLS=ollama@golemframe=http://golemframe.home.arpa:11434,openai@pantheon=http://pantheon.example-vpn:1234/v1
# Or use machine_id/discover in config/router.ha.example.toml.
# API health defaults to every 15 seconds; set health_check_interval_seconds and
# health_check_timeout_seconds in [router] to customize independently of discovery.

# Optional, bounded LAN discovery. Disabled when unset.
# LLM_ROUTER_SCAN_CIDRS=192.168.1.0/24
# LLM_ROUTER_MAX_SCAN_HOSTS=64

# Optional source priority for the `priority` strategy and `auto:priority`.
# First match receives the highest priority. Values may be local, cloud, or provider names.
# LLM_ROUTER_SOURCE_PRIORITY=local,anthropic,openai,cloud

# If loopback Ollama has no tool-capable model, install the best bounded tier that fits.
LLM_ROUTER_AUTO_PROVISION=1
LLM_ROUTER_PROVISION_PRIORITY=balanced
LLM_ROUTER_PROVISION_MAX_GB=8
LLM_ROUTER_PROVISION_DISK_RESERVE_GB=5
# LLM_ROUTER_PROVISION_MODELS=qwen3.5:4b,qwen3.5:2b,qwen3.5:0.8b
# LLM_ROUTER_PROVISION_REMOTE=0

LLM_ROUTER_DISCOVERY_REFRESH=300
# LAN/VPN access (new service-install default): all IPv4 interfaces.
# For this machine only, use LLM_ROUTER_HOST=127.0.0.1 instead.
# Installer shortcuts: --service --lan or --service --localhost.
# Clients use your router machine IP, never 0.0.0.0. Keep the API key enabled,
# restrict access with a firewall/VPN, and use TLS on untrusted networks.
LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=8088
LLM_ROUTER_GATEWAY_API_KEY=replace-with-a-long-random-value
# Status-page saved check targets persist under the service user's config root.
# Optional override (use a private directory owned by the service user):
# LLM_ROUTER_SAVED_HOSTS_FILE=/home/llmrouter/.config/llm-router/saved-hosts.json

# Setting any supported provider key automatically enrolls its chat models.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
